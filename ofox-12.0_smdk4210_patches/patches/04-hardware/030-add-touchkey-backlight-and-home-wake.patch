 static long long g_suppress_power_toggle_until_ms = 0;
 static inline long long nowMs() { struct timeval t; gettimeofday(&t, NULL); return (long long)t.tv_sec * 1000LL + t.tv_usec / 1000; }
+static const char* g_touchkey_brightness_path = "/sys/devices/virtual/sec/sec_touchkey/brightness";
+static long long g_touchkey_light_off_at_ms = 0;
+
+static void updateTouchkeyLight()
+{
+	if (g_touchkey_light_off_at_ms != 0 && nowMs() >= g_touchkey_light_off_at_ms) {
+		TWFunc::write_to_file(g_touchkey_brightness_path, "0");
+		g_touchkey_light_off_at_ms = 0;
+	}
+}
+
+static void activateTouchkeyLight()
+{
+	if (TWFunc::Path_Exists(g_touchkey_brightness_path)) {
+		TWFunc::write_to_file(g_touchkey_brightness_path, "1");
+		g_touchkey_light_off_at_ms = nowMs() + 3000;
+	}
+}
 
